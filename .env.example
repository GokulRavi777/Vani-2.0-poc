# LiveKit Cloud Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Gnani Voice AI (STT & TTS)
GNANI_API_KEY=your_gnani_api_key
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_VOICE=Nalini
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=en-IN

# Google Gemini Orchestration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (SQLite default for local dev; use PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/vani_db

# LangSmith Tracing & Observability
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Vani 2.0
